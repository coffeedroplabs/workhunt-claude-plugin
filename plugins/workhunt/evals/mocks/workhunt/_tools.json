{
  "tools": [
    {
      "name": "list_resumes",
      "title": "List resumes",
      "description": "Lists the user\u0027s WorkHunt resumes, newest first. The baseline resume is the one tailoring starts from.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "description": "Page number, starting at 1.",
            "type": "integer",
            "default": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resumes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "isBaseline": {
                  "type": "boolean"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "editUrl": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "status",
                "isBaseline",
                "updatedAt",
                "editUrl"
              ]
            }
          },
          "page": {
            "type": "integer"
          },
          "totalCount": {
            "type": "integer"
          }
        },
        "required": [
          "resumes",
          "page",
          "totalCount"
        ]
      },
      "annotations": {
        "title": "List resumes",
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    },
    {
      "name": "get_resume",
      "title": "Get a resume",
      "description": "Gets one resume\u0027s full content. A tailored resume that is still being written has status \u0027generating\u0027; its preview updates by itself when it is ready, with no further call needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "resumeId": {
            "description": "The resume id, from list_resumes or tailor_resume.",
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "resumeId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "isBaseline": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "content": true,
          "generationError": {
            "type": [
              "string",
              "null"
            ]
          },
          "editUrl": {
            "type": "string"
          },
          "template": {
            "type": "integer"
          },
          "formattingOptions": {
            "type": "object",
            "properties": {
              "fontFamily": {
                "type": "string"
              },
              "fontSizePt": {
                "type": "number"
              },
              "lineHeight": {
                "type": "number"
              },
              "marginInches": {
                "type": "number"
              },
              "accentColor": {
                "type": "string"
              },
              "paperSize": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "Auto",
                  "A4",
                  "Letter",
                  null
                ],
                "default": null
              }
            },
            "required": [
              "fontFamily",
              "fontSizePt",
              "lineHeight",
              "marginInches",
              "accentColor"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "isBaseline",
          "updatedAt",
          "content",
          "generationError",
          "editUrl",
          "template",
          "formattingOptions"
        ]
      },
      "annotations": {
        "title": "Get a resume",
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://workhunt/resume-v2.html"
