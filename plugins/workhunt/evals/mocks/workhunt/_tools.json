    {
      "name": "tailor_resume",
      "title": "Tailor resume to a job",
      "description": "Creates a new resume tailored to a job posting, starting from the user\u0027s baseline resume. Pass the full job description text. Uses one of the user\u0027s daily AI analyses. Returns the tailored resume, or status \u0027generating\u0027 if it is still being written: the preview then fills in by itself when it is ready, with no further call needed. The returned sessionId is used by generate_cover_letter and generate_interview_prep.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobDescription": {
            "description": "The full text of the job posting.",
            "type": "string"
          },
          "jobTitle": {
            "description": "Optional short name for this job, e.g. \u0027Senior Engineer at Acme\u0027.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "jobDescription"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "resume": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "isBaseline": {
                "type": "boolean"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "content": true,
              "generationError": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "editUrl": {
                "type": "string"
              },
              "template": {
                "type": "integer"
              },
              "formattingOptions": {
                "type": "object",
                "properties": {
                  "fontFamily": {
                    "type": "string"
                  },
                  "fontSizePt": {
                    "type": "number"
                  },
                  "lineHeight": {
                    "type": "number"
                  },
                  "marginInches": {
                    "type": "number"
                  },
                  "accentColor": {
                    "type": "string"
                  },
                  "paperSize": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "Auto",
                      "A4",
                      "Letter",
                      null
                    ],
                    "default": null
                  }
                },
                "required": [
                  "fontFamily",
                  "fontSizePt",
                  "lineHeight",
                  "marginInches",
                  "accentColor"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "status",
              "isBaseline",
              "updatedAt",
              "content",
              "generationError",
              "editUrl",
              "template",
              "formattingOptions"
            ]
          },
          "tailorUrl": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "resume",
          "tailorUrl"
        ]
      },
      "annotations": {
        "title": "Tailor resume to a job",
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://workhunt/resume-v2.html"
        },
        "openai/outputTemplate": "ui://workhunt/resume-v2.html",
        "openai/toolInvocation/invoking": "Tailoring your resume\u2026",
        "openai/toolInvocation/invoked": "Resume tailored"
      }
    },
    {
      "name": "generate_cover_letter",
      "title": "Write a cover letter",
      "description": "Writes a cover letter for a job already tailored with tailor_resume (pass its sessionId). Returns the letter, or status \u0027generating\u0027 - then call get_cover_letter. If the session already has a cover letter it is returned unchanged, never rewritten (the user can regenerate it in WorkHunt).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "description": "The sessionId returned by tailor_resume.",
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sessionId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "generationError": {
            "type": [
              "string",
              "null"
            ]
          },
          "openUrl": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "status",
          "body",
          "generationError",
          "openUrl"
        ]
      },
      "annotations": {
        "title": "Write a cover letter",
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      }
    },
