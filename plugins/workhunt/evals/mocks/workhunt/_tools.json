    {
      "name": "generate_interview_prep",
      "title": "Generate interview prep",
      "description": "Generates interview preparation for a job tailored with tailor_resume (needs a WorkHunt pass): likely interview questions, a company brief and recruiter-screen scripts by default. Only missing sections are generated; sections that already exist are returned unchanged, never replaced (the user can regenerate them in WorkHunt). If pending is non-empty, call again with sections set to pending to generate the rest.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "description": "The sessionId returned by tailor_resume.",
            "type": "string",
            "format": "uuid"
          },
          "sections": {
            "description": "Optional subset to generate: questions, company_brief, recruiter_scripts, day_of, technical_challenges, resume_coaching.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          }
        },
        "required": [
          "sessionId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "questions": true,
          "companyBrief": true,
          "recruiterScripts": true,
          "dayOfChecklist": true,
          "technicalChallenges": true,
          "resumeCoaching": true,
          "openUrl": {
            "type": "string"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sessionId",
          "questions",
          "companyBrief",
          "recruiterScripts",
          "dayOfChecklist",
          "technicalChallenges",
          "resumeCoaching",
          "openUrl",
          "pending"
        ]
      },
      "annotations": {
        "title": "Generate interview prep",
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "_meta": {
        "openai/toolInvocation/invoking": "Preparing interview material\u2026"
      }
    },
